{
  "name": "south-african-inequality-explained",
  "version": "1.0.0",
  "private": true,
  "description": "A data visualization website about South African inequality.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview --host 0.0.0.0",
    "data:survey": "node scripts/prepare-survey-data.mjs",
    "test:unit": "node --test scripts/*.test.mjs",
    "test:data": "npm run test:unit",
    "test:browser": "playwright test",
    "test": "npm run test:unit && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^7.3.6"
  }
}
